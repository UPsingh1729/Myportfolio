<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=!, initial-scale=1.0">
    <title>Work Page</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
     <%- include('navbar') %>
   <section class="work-section" id="work">

    <div class="section-heading">
        <p>MY RECENT WORK</p>
        <h1>Projects</h1>
    </div>

    <div class="projects-container">

        <!-- Project 1 -->
        <div class="project-card">
            <div class="project-image">
                <span>PROJECT 01</span>
            </div>

            <div class="project-content">
                <p class="project-type">WEB APPLICATION</p>

                <h2>Portfolio Website</h2>

                <p>
                    A modern personal portfolio website built using Node.js,
                    Express.js and EJS to showcase my skills, projects and
                    experience.
                </p>

                <div class="project-tech">
                    <span>Node.js</span>
                    <span>Express</span>
                    <span>EJS</span>
                </div>

                <div class="project-links">
                    <a href="#" target="_blank">GitHub ↗</a>
                    <a href="#" target="_blank">Live Demo ↗</a>
                </div>
            </div>
        </div>


        <!-- Project 2 -->
        <div class="project-card">
            <div class="project-image">
                <span>PROJECT 02</span>
            </div>

            <div class="project-content">
                <p class="project-type">FULL STACK</p>

                <h2>Project Name</h2>

                <p>
                    Add a short description of your project here. Explain what
                    problem it solves and what technologies you used to build it.
                </p>

                <div class="project-tech">
                    <span>JavaScript</span>
                    <span>Node.js</span>
                    <span>MongoDB</span>
                </div>

                <div class="project-links">
                    <a href="#" target="_blank">GitHub ↗</a>
                    <a href="#" target="_blank">Live Demo ↗</a>
                </div>
            </div>
        </div>


        <!-- Project 3 -->
        <div class="project-card">
            <div class="project-image">
                <span>PROJECT 03</span>
            </div>

            <div class="project-content">
                <p class="project-type">OTHER PROJECT</p>

                <h2>Project Name</h2>

                <p>
                    Add your project description here. Mention the main features,
                    technologies and your contribution to the project.
                </p>

                <div class="project-tech">
                    <span>HTML</span>
                    <span>CSS</span>
                    <span>JavaScript</span>
                </div>

                <div class="project-links">
                    <a href="#" target="_blank">GitHub ↗</a>
                    <a href="#" target="_blank">Live Demo ↗</a>
                </div>
            </div>
        </div>

    </div>

</section>
</body>
</html>
