<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thank You for Submitting</title>
    <!-- Link to the external CSS file -->
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="thank-you-screen-wrapper">
    <div class="thank-you-container">
     
    <div class="thank-you-container">
        <!-- Visual Success Anchor -->
        <div class="success-icon">✓</div>
        
        <h1>Thank You!</h1>
        <p class="main-message">Your response has been successfully submitted.</p>
        <p class="sub-message">We appreciate your time and **will contact you soon** regarding your inquiry.</p>
        
        <!-- Extra Content Area -->
        <div class="extra-content">
            <h3>What happens next?</h3>
            <ul>
                <li>Our team will review your details within 24 business hours.</li>
                <li>You will receive a confirmation email shortly.</li>
                <li>In the meantime, feel free to explore our resources.</li>
            </ul>
        </div>
        
        <!-- Action Button -->
        <a href="/" class="btn-home">Back to Homepage</a>
    </div>
</body>
</html>

